# Public origin of the deployed site — used for metadata, OG tags and the sitemap.
NEXT_PUBLIC_SITE_URL=https://rodrigorocha.dev

# Contact form delivery (https://resend.com — free tier is enough).
# Without RESEND_API_KEY the form validates but tells visitors to use direct email.
RESEND_API_KEY=

# Verified sender. Until you verify your own domain in Resend, leave the default.
CONTACT_FROM_EMAIL="Portfolio <onboarding@resend.dev>"

# Where messages land. Defaults to the address in src/content/site.ts.
CONTACT_TO_EMAIL=rodrigo.faria.rocha.dev@gmail.com
